LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# Optional: set LLM_PROVIDER=gemini to use this key instead.
GEMINI_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APP_URL=http://localhost:5173
# Local gRPC connection. Compose overrides these for container networking.
AI_GRPC_ADDRESS=127.0.0.1:50051
AI_GRPC_LISTEN=127.0.0.1:50051
# Optional local development path. Docker includes pinned Qlty CLI automatically.
QLTY_BIN=qlty
